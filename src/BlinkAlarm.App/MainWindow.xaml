<Window x:Class="BlinkAlarm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BlinkAlarm.App"
        xmlns:controls="clr-namespace:BlinkAlarm.App.Controls"
        Title="眨眼报警助手" Width="1240" Height="840" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="15" UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding StopAlarmCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Show" />
        <local:InverseBoolToVisibilityConverter x:Key="Hide" />

        <Style x:Key="MonitorButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Content" Value="▶   开始监测" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Height" Value="64" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                    <Setter Property="Background" Value="{StaticResource TextBrush}" />
                    <Setter Property="Content" Value="■   停止监测" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#94A3B8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="ok">
                    <Setter Property="Fill" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="warn">
                    <Setter Property="Fill" Value="#F59E0B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="danger">
                    <Setter Property="Fill" Value="#EF4444" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EyeOutline" TargetType="Polygon">
            <Setter Property="Stroke" Value="#22C55E" />
            <Setter Property="Fill" Value="#3322C55E" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style x:Key="EyeMeter" TargetType="ProgressBar" BasedOn="{StaticResource Meter}">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#22C55E" />
        </Style>

        <Style x:Key="StageLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════ 左侧：摄像头画面 ═════════════ -->
        <Grid Grid.Column="0">
            <Border x:Name="StageShape" Background="{StaticResource StageBrush}" CornerRadius="20" />
            <Grid>
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=StageShape}" />
                </Grid.OpacityMask>

                <!-- 画面 + 眼睛轮廓。两者放在同一个按画面像素定尺寸的容器里，一起缩放、一起镜像。 -->
                <Viewbox Stretch="Uniform" Visibility="{Binding HasPreview, Converter={StaticResource Show}}">
                    <Grid Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="{Binding MirrorScale}" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Image Source="{Binding Preview}" Stretch="Fill" />
                        <Polygon Points="{Binding LeftEyePoints}">
                            <Polygon.Style>
                                <Style TargetType="Polygon" BasedOn="{StaticResource EyeOutline}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftClosed}" Value="True">
                                            <Setter Property="Stroke" Value="#F87171" />
                                            <Setter Property="Fill" Value="#33F87171" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polygon.Style>
                        </Polygon>
                        <Polygon Points="{Binding RightEyePoints}">
                            <Polygon.Style>
                                <Style TargetType="Polygon" BasedOn="{StaticResource EyeOutline}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightClosed}" Value="True">
                                            <Setter Property="Stroke" Value="#F87171" />
                                            <Setter Property="Fill" Value="#33F87171" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polygon.Style>
                        </Polygon>
                    </Grid>
                </Viewbox>

                <!-- 没有画面时的提示 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding HasPreview, Converter={StaticResource Hide}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE890;" FontSize="56" HorizontalAlignment="Center"
                               Foreground="#475569" />
                    <TextBlock Text="点击右侧「开始监测」打开摄像头" FontSize="18" Margin="0,18,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource StageTextBrush}"
                               Visibility="{Binding HasError, Converter={StaticResource Hide}}" />
                    <TextBlock Text="请让使用者正对摄像头，保持面部光线充足" FontSize="14" Margin="0,8,0,0"
                               HorizontalAlignment="Center" Foreground="#64748B"
                               Visibility="{Binding HasError, Converter={StaticResource Hide}}" />
                    <TextBlock Text="{Binding ErrorText}" FontSize="16" Margin="0,18,0,0" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="#FCA5A5"
                               Visibility="{Binding HasError, Converter={StaticResource Show}}" />
                </StackPanel>

                <!-- 状态 -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                        Background="#B3000000" CornerRadius="19" Padding="16,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource ToneDot}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 校准进度 -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="340"
                        Background="#CC000000" CornerRadius="16" Padding="24,20"
                        Visibility="{Binding IsCalibrating, Converter={StaticResource Show}}">
                    <StackPanel>
                        <TextBlock Text="正在校准" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="请自然睁眼，正视摄像头约 2 秒" Foreground="{StaticResource StageTextBrush}"
                                   FontSize="14" Margin="0,6,0,14" HorizontalAlignment="Center" />
                        <ProgressBar Style="{StaticResource EyeMeter}" Foreground="#F59E0B"
                                     Value="{Binding CalibrationProgress, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!-- 左右眼开合度 -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="460" Margin="18"
                        Background="#B3000000" CornerRadius="16" Padding="20,14"
                        Visibility="{Binding HasPreview, Converter={StaticResource Show}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource StageLabel}" FontWeight="SemiBold"
                                           Text="{Binding LeftOpenness, StringFormat={}{0:P0}}" />
                                <TextBlock Style="{StaticResource StageLabel}" Text="左眼开合度" />
                            </DockPanel>
                            <ProgressBar Value="{Binding LeftOpenness, Mode=OneWay}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource EyeMeter}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LeftClosed}" Value="True">
                                                <Setter Property="Foreground" Value="#F87171" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource StageLabel}" FontWeight="SemiBold"
                                           Text="{Binding RightOpenness, StringFormat={}{0:P0}}" />
                                <TextBlock Style="{StaticResource StageLabel}" Text="右眼开合度" />
                            </DockPanel>
                            <ProgressBar Value="{Binding RightOpenness, Mode=OneWay}">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource EyeMeter}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RightClosed}" Value="True">
                                                <Setter Property="Foreground" Value="#F87171" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 报警：盖住整个画面，停止按钮足够大 -->
                <Grid Background="#F2B91C1C" Visibility="{Binding AlarmActive, Converter={StaticResource Show}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="64" Foreground="White"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="已触发报警" FontSize="46" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Text="正在呼叫照护者 · 按 Esc 也可停止" FontSize="17" Foreground="#FECACA"
                                   HorizontalAlignment="Center" Margin="0,8,0,32" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding StopAlarmCommand}"
                                Content="停止报警" Width="340" Height="96" FontSize="28"
                                Background="White" Foreground="{StaticResource DangerHoverBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════ 右侧：计数、开关、设置 ═════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 计数 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Count}" FontSize="60" FontWeight="Bold" LineHeight="62"
                                       LineStackingStrategy="BlockLineHeight" />
                            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,8">
                                <Run Text="/" />
                                <Run Text="{Binding TargetBlinks, Mode=OneWay, StringFormat={}{0:0}}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                            <TextBlock Text="连续眨眼" Style="{StaticResource Muted}" FontSize="14" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Dots}" Focusable="False" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse x:Name="Dot" Width="14" Height="14" Margin="0,0,7,4"
                                                 Fill="{StaticResource LineBrush}" />
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Style="{StaticResource Meter}" Height="6" Margin="0,12,0,8"
                                 Value="{Binding WindowRemaining, Mode=OneWay}" />
                    <TextBlock Text="{Binding RuleText}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{Binding LastAlarmText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 开始 / 停止 -->
            <Button Grid.Row="1" Style="{StaticResource MonitorButton}" Command="{Binding ToggleMonitorCommand}"
                    Margin="0,16" />

            <!-- 设置 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                <TabControl Style="{StaticResource SegmentTabs}" x:Name="SettingsTabs">
                    <TabItem Header="触发" Style="{StaticResource SegmentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="灵敏度" Margin="0,7,0,0">
                                    <TextBlock Text="{Binding Sensitivity, StringFormat={}{0:0}}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </HeaderedContentControl>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100"
                                        SmallChange="1" LargeChange="5" Value="{Binding Sensitivity}" />
                                <TextBlock Text="{Binding ThresholdText}" Style="{StaticResource Muted}" Margin="0,2,0,6" />

                                <HeaderedContentControl Style="{StaticResource Row}" Header="眨眼次数">
                                    <controls:Stepper Value="{Binding TargetBlinks}" Minimum="2" Maximum="10" Unit="次" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="时间窗口">
                                    <controls:Stepper Value="{Binding BlinkWindowSeconds}" Minimum="3" Maximum="30" Unit="秒" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="报警冷却">
                                    <controls:Stepper Value="{Binding CooldownSeconds}" Minimum="1" Maximum="60" Unit="秒" />
                                </HeaderedContentControl>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="报警" Style="{StaticResource SegmentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="本机声音报警">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SoundEnabled}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="一直响到手动停止">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AlarmUntilStopped}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="报警时长"
                                                        IsEnabled="{Binding UsesDuration}">
                                    <controls:Stepper Value="{Binding AlarmDurationSeconds}" Minimum="1" Maximum="120" Unit="秒" />
                                </HeaderedContentControl>

                                <HeaderedContentControl Style="{StaticResource Row}" Header="报警声音">
                                    <TextBlock Text="{Binding SoundFileText}" FontSize="15" MaxWidth="230"
                                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </HeaderedContentControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource SecondaryButton}" Content="选择 wav 文件"
                                            Command="{Binding BrowseSoundCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="恢复内置警笛"
                                            Command="{Binding ClearSoundCommand}" />
                                </Grid>
                                <Button Margin="0,8,0,0" Command="{Binding TestSoundCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Content" Value="试听报警声" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTestingSound}" Value="True">
                                                    <Setter Property="Content" Value="停止试听" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="联动" Style="{StaticResource SegmentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="报警时通知外部设备">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WebhookEnabled}" />
                                </HeaderedContentControl>
                                <TextBlock Text="Webhook 地址（Home Assistant、米家等）" Style="{StaticResource SectionTitle}"
                                           Margin="0,8,0,6" />
                                <TextBox Style="{StaticResource Input}"
                                         Text="{Binding WebhookUrl, UpdateSourceTrigger=PropertyChanged}" />

                                <HeaderedContentControl Style="{StaticResource Row}" Header="请求方式" Margin="0,12,0,0">
                                    <Border Background="{StaticResource SubtleBrush}" CornerRadius="12" Padding="4">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Choice}" Content="POST" GroupName="Method"
                                                         IsChecked="{Binding WebhookIsPost}" />
                                            <RadioButton Style="{StaticResource Choice}" Content="GET" GroupName="Method"
                                                         IsChecked="{Binding WebhookIsGet}" />
                                        </StackPanel>
                                    </Border>
                                </HeaderedContentControl>

                                <TextBlock Text="附带内容（JSON，仅 POST）" Style="{StaticResource SectionTitle}" Margin="0,12,0,6" />
                                <TextBox Style="{StaticResource Input}" FontFamily="Consolas"
                                         Text="{Binding WebhookPayload, UpdateSourceTrigger=PropertyChanged}" />

                                <Button Style="{StaticResource PrimaryButton}" Content="发送测试" Margin="0,14,0,0"
                                        Command="{Binding TestWebhookCommand}" />
                                <TextBlock Text="{Binding WebhookStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="画面" Style="{StaticResource SegmentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="摄像头编号">
                                    <controls:Stepper Value="{Binding CameraIndex}" Minimum="0" Maximum="9" />
                                </HeaderedContentControl>
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="内置摄像头一般是 0，外接 USB 摄像头请尝试 1、2…" />
                                <HeaderedContentControl Style="{StaticResource Row}" Header="镜像显示" Margin="0,12,0,7">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mirror}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="显示眼睛轮廓">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowLandmarks}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="打开软件后自动开始监测">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoStart}" />
                                </HeaderedContentControl>
                                <Button Style="{StaticResource SecondaryButton}" Content="重新校准睁眼基准" Margin="0,12,0,0"
                                        Command="{Binding RecalibrateCommand}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                           Text="更换使用者、调整了摄像头位置或光线明显变化后，建议重新校准。" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="高级" Style="{StaticResource SegmentTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
                            <StackPanel>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="最短闭眼">
                                    <controls:Stepper Value="{Binding MinClosedMs}" Minimum="30" Maximum="300" Step="10"
                                                      Unit="毫秒" ValueWidth="84" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Style="{StaticResource Row}" Header="最长闭眼">
                                    <controls:Stepper Value="{Binding MaxClosedMs}" Minimum="400" Maximum="3000" Step="100"
                                                      Unit="毫秒" ValueWidth="84" />
                                </HeaderedContentControl>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Text="一般无需修改。闭眼时间短于「最短」视为抖动，长于「最长」视为闭眼休息，都不计入眨眼次数。" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <TextBlock Grid.Row="3" Text="{Binding FooterText}" Style="{StaticResource Muted}" FontSize="12"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</Window>
